commit_msg=$(cat "$1")

case "$commit_msg" in
  feat:*)
    exit 0
    ;;
  fix:*)
    exit 0
    ;;
  docs:*)
    exit 0
    ;;
  refactor:*)
    exit 0
    ;;
  test:*)
    exit 0
    ;;
  chore:*)
    exit 0
    ;;
  *)
    echo "Invalid commit message"
    echo ""
    echo "Allowed prefixes:"
    echo "  feat:"
    echo "  fix:"
    echo "  docs:"
    echo "  refactor:"
    echo "  test:"
    echo "  chore:"
    echo ""
    echo "Example:"
    echo "  feat: add socket authentication"
    exit 1
    ;;
esac